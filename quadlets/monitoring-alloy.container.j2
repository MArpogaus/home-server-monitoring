[Unit]
After=monitoring-loki.service

[Container]
Image={{ monitoring_service_alloy_image }}
ContainerName=monitoring-alloy
# Ships the host journal (all users' containers log there) to Loki.
# Journal files are root:systemd-journal 0640; the monitoring user is in that
# group and keep-groups carries it into the container.
User=0
GroupAdd=keep-groups
SecurityLabelDisable=true
# No :z/:Z on any of these. SecurityLabelDisable above already opts out of
# SELinux confinement, and relabelling /var/log/journal would break
# journald for the whole host.
Volume=./configs/config.alloy:/etc/alloy/config.alloy:ro
Volume=/var/log/journal:/var/log/journal:ro
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=alloy-data:/var/lib/alloy/data
PodmanArgs={{ monitoring_service_alloy_extra_args }}
AutoUpdate={{ monitoring_service_auto_update }}
Pod=monitoring.pod

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
