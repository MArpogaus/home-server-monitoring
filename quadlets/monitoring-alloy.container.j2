[Unit]
After=monitoring-loki.service

[Container]
Image={{ monitoring_service_alloy_image }}
ContainerName=monitoring-alloy
# The image sets no USER and owns /var/lib/alloy as 473; root without
# DAC_OVERRIDE cannot even enter it. Journal files are root:systemd-journal
# 0640; keep-groups carries the service user's supplementary group in.
User=473
GroupAdd=keep-groups
SecurityLabelDisable=true
# No :z/:Z: relabelling /var/log/journal breaks journald for the whole host.
Volume=./configs/config.alloy:/etc/alloy/config.alloy:ro
Volume=/var/log/journal:/var/log/journal:ro
Volume=/etc/machine-id:/etc/machine-id:ro
# :U chowns the volume to the image's user on each start.
Volume=alloy-data:/var/lib/alloy/data:U
PodmanArgs={{ monitoring_service_alloy_extra_args }}
AutoUpdate={{ monitoring_service_auto_update }}
Pod=monitoring.pod

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
