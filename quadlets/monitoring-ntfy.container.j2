[Container]
Image={{ monitoring_service_ntfy_image }}
ContainerName=monitoring-ntfy
# Configured by environment, so there is no config file to template.
Environment=NTFY_LISTEN_HTTP=:8081
Environment=NTFY_BASE_URL={{ monitoring_service_ntfy_base_url }}
Environment=NTFY_BEHIND_PROXY=true
# Without a cache file the history dies with the process: a phone that was
# offline never receives what was published meanwhile, and a reboot wipes
# the topic.
Environment=NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
Environment=NTFY_CACHE_DURATION=72h
Volume=ntfy-cache:/var/cache/ntfy:Z
# Users, ACL and tokens are declared here and synced into user.db at start.
# The bcrypt salt derives from the password so the unit is stable across runs.
# The password hash and the bearer token go through an EnvironmentFile, which
# vars/main.yml keeps at 0600; a unit file is 0644.
EnvironmentFile=./configs/ntfy-auth.env
Volume=ntfy-data:/var/lib/ntfy:Z
Exec=serve
PodmanArgs={{ monitoring_service_ntfy_extra_args }}
HealthCmd=wget -qO /dev/null http://127.0.0.1:8081/v1/health
HealthInterval=60s
HealthStartPeriod=30s
Pod=monitoring.pod
