# This file stays world-readable although it carries the ntfy token: the
# container runs as `nobody`, which maps outside the service user, so a 0600
# file owned by that user is unreadable to Alertmanager. The service home is
# 0750, so only this user and root can reach it.
route:
  receiver: ntfy
  # One notification per alert: a group shares only the annotations common to
  # all its members, and ntfy renders a missing one as "<no value>".
  group_by: ['...']
  group_wait: 30s
  repeat_interval: 12h
  routes:
    - matchers: [severity="info"]
      receiver: ntfy-events
      group_wait: 10s
      repeat_interval: 1h

receivers:
  # The URL template is decoded in README.md.
  - name: ntfy
    webhook_configs:
      - url: &ntfy_url "{{ monitoring_service_ntfy_url }}?template=yes&title=%7B%7B.commonLabels.alertname%7D%7D%7B%7Bif%20eq%20.status%20%22resolved%22%7D%7D%20resolved%7B%7Bend%7D%7D&message=%7B%7B.commonAnnotations.summary%7D%7D%7B%7Bif%20.commonAnnotations.description%7D%7D%0A%7B%7B.commonAnnotations.description%7D%7D%7B%7Bend%7D%7D"
        send_resolved: true
        http_config: &ntfy_auth
          authorization:
            credentials: "{{ monitoring_service_ntfy_token }}"
  - name: ntfy-events
    webhook_configs:
      - url: *ntfy_url
        send_resolved: false
        http_config: *ntfy_auth
