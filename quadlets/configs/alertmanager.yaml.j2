route:
  receiver: webhook
  group_by: ['...']
  group_wait: 30s
  repeat_interval: 24h
  routes:
    - matchers: [severity="critical"]
      receiver: webhook
      repeat_interval: 4h
    - matchers: [severity="info"]
      receiver: webhook-info
      group_wait: 10s
      repeat_interval: 1h

inhibit_rules:
  - source_matchers: [alertname="LogShippingStopped"]
    target_matchers: [source!="prometheus"]

# A receiver without a webhook drops the notification.
receivers:
{% for name, resolved in [('webhook', true), ('webhook-info', false)] %}
  - name: {{ name }}
{% if monitoring_service_alert_webhook_url | length > 0 %}
    webhook_configs:
      - url: "{{ monitoring_service_alert_webhook_url }}"
        send_resolved: {{ resolved | lower }}
{% if monitoring_service_alert_webhook_token | length > 0 %}
        http_config:
          authorization:
            credentials: "{{ monitoring_service_alert_webhook_token }}"
{% endif %}
{% endif %}
{% endfor %}
