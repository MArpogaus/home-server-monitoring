{% set ntfy = 'http://127.0.0.1:8081/alerts?template=yes&title=%7B%7B.commonLabels.alertname%7D%7D%7B%7Bif%20eq%20.status%20%22resolved%22%7D%7D%20resolved%7B%7Bend%7D%7D&message=%7B%7B.commonAnnotations.summary%7D%7D%7B%7Bif%20.commonAnnotations.description%7D%7D%0A%7B%7B.commonAnnotations.description%7D%7D%7B%7Bend%7D%7D' %}
route:
  receiver: ntfy-warning
  group_by: ['...']
  group_wait: 30s
  repeat_interval: 24h
  routes:
    - matchers: [severity="critical"]
      receiver: ntfy-critical
      repeat_interval: 4h
    - matchers: [severity="info"]
      receiver: ntfy-info
      group_wait: 10s
      repeat_interval: 1h

inhibit_rules:
  - source_matchers: [alertname="LogShippingStopped"]
    target_matchers: [source!="prometheus"]

receivers:
  - name: ntfy-critical
    webhook_configs:
      - url: "{{ ntfy }}&priority=5"
        send_resolved: true
        http_config: &ntfy_auth
          authorization:
            credentials: "{{ monitoring_service_ntfy_token }}"
  - name: ntfy-warning
    webhook_configs:
      - url: "{{ ntfy }}&priority=3"
        send_resolved: true
        http_config: *ntfy_auth
  - name: ntfy-info
    webhook_configs:
      - url: "{{ ntfy }}&priority=2"
        send_resolved: false
        http_config: *ntfy_auth
