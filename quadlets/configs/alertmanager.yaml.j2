route:
  receiver: ntfy
  group_by: ['...']
  group_wait: 30s
  repeat_interval: 24h
  routes:
    - matchers: [severity="critical"]
      receiver: ntfy
      repeat_interval: 4h
    - matchers: [severity="info"]
      receiver: ntfy-info
      group_wait: 10s
      repeat_interval: 1h

inhibit_rules:
  - source_matchers: [alertname="LogShippingStopped"]
    target_matchers: [source!="prometheus"]

receivers:
  - name: ntfy
    webhook_configs:
      - url: &ntfy_url "http://127.0.0.1:8081/alerts?template=alertmanager"
        send_resolved: true
        http_config: &ntfy_auth
          authorization:
            credentials: "{{ monitoring_service_ntfy_token }}"
  - name: ntfy-info
    webhook_configs:
      - url: *ntfy_url
        send_resolved: false
        http_config: *ntfy_auth
