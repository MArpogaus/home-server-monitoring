route:
  receiver: webhook
  group_by: ['...']
  repeat_interval: {{ monitoring_service_alert_repeat_merged.default }}
  routes:
    - matchers: [severity="critical"]
      repeat_interval: {{ monitoring_service_alert_repeat_merged.critical }}
    - matchers: [severity="info"]
      receiver: webhook-info
      group_wait: 10s
      repeat_interval: {{ monitoring_service_alert_repeat_merged.info }}

inhibit_rules:
  - source_matchers: [alertname="LogShippingStopped"]
    target_matchers: [source!="prometheus"]

receivers:
{% for name, resolved in [('webhook', true), ('webhook-info', false)] %}
  - name: {{ name }}
{% if monitoring_service_alert_webhook_url | length > 0 %}
    webhook_configs:
      - url: "{{ monitoring_service_alert_webhook_url }}"
        send_resolved: {{ resolved | lower }}
{% if monitoring_service_alert_webhook_token | length > 0 %}
        http_config:
          authorization:
            credentials_file: /run/secrets/monitoring_service_alert_webhook_token
{% endif %}
{% endif %}
{% endfor %}
