        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (ip) (count_over_time({container=\"bunker-nginx\"} | pattern `<site> <ip> - <_> - [<_>] \"<method> <uri> <_>\" <status> <bytes> \"<_>\" \"<ua>\"` | site != \"bwapi\" | site != \"\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ],
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11
    },
