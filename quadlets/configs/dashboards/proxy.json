    {
      "title": "Bans and denials",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{container=\"bunker-nginx\"} |~ \"denied access|\\\\[BADBEHAVIOR\\\\]\" | regexp \"client: (?P<client>[0-9.]+)\" | line_format \"{{.client}} {{.__line__}}\" ",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "id": 14
    },
    {
      "title": "Errors and certificate events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{container=~\"bunker-.*\"} |~ \"\\\\[(error|crit|alert|emerg)\\\\]|\\\\[ERROR\\\\]|(?i)certbot|certificate\" != \"denied access\" != \"ModSecurity\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "id": 15
    }
  ]
