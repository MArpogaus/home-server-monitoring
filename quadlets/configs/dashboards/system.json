{
  "uid": "system",
  "title": "System log",
  "tags": [
    "home-server"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Host",
      "type": "link",
      "url": "/d/host",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Proxy",
      "type": "link",
      "url": "/d/proxy",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Nextcloud",
      "type": "link",
      "url": "/d/nextcloud",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "System log",
      "type": "link",
      "url": "/d/system",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Boots",
        "expr": "{job=\"systemd-journal\", unit=\"init.scope\"} |= \"Startup finished in\"",
        "titleFormat": "Boot",
        "textFormat": "Startup finished"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "Deploys",
        "expr": "{syslog_identifier=\"systemd\", user_unit=\"nc-pod.service\"} |= \"Started\"",
        "titleFormat": "Deploy",
        "textFormat": "Nextcloud pod started"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "title": "Active alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(alertmanager_alerts{state=\"active\"}) or vector(0)",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Alerts Alertmanager holds right now, from Prometheus and Loki rules. The list below names them.",
      "id": 2
    },
    {
      "title": "Unit failures (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({syslog_identifier=\"systemd\", user_unit!~\"[0-9a-f]{64}-.*\"} |~ \"(?i)failed with result\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "systemd units that ended in failure, system and service users. Podman's transient health-check units are not counted.",
      "id": 3
    },
    {
      "title": "SSH logins (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({unit=\"sshd.service\"} |= \"Accepted publickey\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Accepted key logins. Each one also reaches the phone (SshLogin).",
      "id": 4
    },
    {
      "title": "SSH failures (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({unit=\"sshd.service\"} |~ \"Invalid user|Failed (publickey|password)\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "SSH is LAN-only, so anything here is a device on the LAN or a typo.",
      "id": 5
    },
    {
      "title": "SELinux denials (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({syslog_identifier=\"audit\"} |= \"avc:  denied\" != \"permissive=1\" != \"comm=\\\"pasta\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Enforced denials only, without pasta's capability probes at every pod start (harmless, excluded from the alert too).",
      "id": 6
    },
    {
      "title": "OOM kills (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({syslog_identifier=\"kernel\"} |= \"Killed process\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Processes the kernel killed for hitting a container's memory ceiling. The OomKill alert names the process.",
      "id": 7
    },
    {
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 8
    },
    {
      "title": "Firing Prometheus alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "none firing",
          "mappings": [
            {
              "type": "value",
              "options": {
                "critical": {
                  "text": "critical",
                  "color": "red",
                  "index": 0
                },
                "warning": {
                  "text": "warning",
                  "color": "orange",
                  "index": 1
                },
                "info": {
                  "text": "info",
                  "color": "blue",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom",
                "value": {
                  "cellOptions": {
                    "type": "color-text"
                  },
                  "width": 90
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alertname"
            },
            "properties": [
              {
                "id": "custom",
                "value": {
                  "width": 200
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "severity",
            "desc": false
          }
        ],
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Host and probe alerts (Prometheus rules) with their labels. Loki's alerts have no queryable state; ruler remote_write into Prometheus stalled every evaluation ('appender not ready'), so they show only as events in the logs below and on the phone.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1
            }
          }
        }
      ],
      "id": 9
    },
    {
      "title": "Journal errors by unit",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (unit) (count_over_time({job=\"systemd-journal\", priority=~\"[0-3]\", unit!~\"user@.*\"} [$__auto]))",
          "legendFormat": "{{unit}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Lines at priority emerg, alert, crit or err per interval, host units only. Container output is excluded: the proxy pod's journald driver files every stderr line as err, and the other pods log at info (passthrough).",
      "id": 10
    },
    {
      "title": "Restarts per unit",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (user_unit) (count_over_time({syslog_identifier=\"systemd\", user_unit=~\".+\"} |= \"Scheduled restart job\" [$__auto]))",
          "legendFormat": "{{user_unit}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Automatic restarts of container units. A deploy restarts the pods once; a bar every ten seconds is a crash loop (ContainerRestartLoop).",
      "id": 11
    },
    {
      "title": "Scheduled jobs",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (unit) (count_over_time({unit=~\"btrfs-backup@.*|btrfs-snapshot@.*|pg-dumpall.service\"} |= \"Deactivated successfully\" [$__auto]))",
          "legendFormat": "{{unit}} finished",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum by (unit) (count_over_time({unit=~\"btrfs-backup@.*|btrfs-snapshot@.*|pg-dumpall.service\"} |~ \"Failed with result\" [$__auto]))",
          "legendFormat": "{{unit}} FAILED",
          "queryType": "range",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*FAILED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Snapshots hourly, the database dump before the Nextcloud snapshot, the backup to the NAS nightly. A missing bar raises BackupMissing after 30 h.",
      "id": 12
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 13
    },
    {
      "title": "Container state changes",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{syslog_identifier=\"systemd\", user_unit=~\"(nextcloud|bunker|monitoring|nc|proxy)-.*\"} |~ \"Started|Stopped|Failed with result|Scheduled restart|Main process exited\" | line_format \"{{.user_unit}}: {{ __line__ }}\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "Manager messages about the service users' containers. A deploy restarts the pods; anything else here deserves a look.",
      "id": 14
    },
    {
      "title": "Logins",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{unit=\"sshd.service\"} |~ \"Accepted publickey|Failed (publickey|password)|Invalid user\" | regexp \"(?P<what>Accepted publickey|Failed publickey|Failed password|Invalid user) (for )?(?P<user>[^ ]+) from (?P<ip>[0-9a-f.:]+)\" | line_format \"{{.what}}: {{.user}} from {{.ip}}\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "Accepted and refused SSH logins with user and address.",
      "id": 15
    },
    {
      "title": "Updates, reboots, boots",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "{unit=~\"rpm-ostreed.service|auto-reboot-staged.service|init.scope\"} |~ \"Staged|Deployment|Rebooting|Startup finished|reboot|No staged deployment\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "rpm-ostree stages an OS update (UpdateStaged); auto-reboot-staged.timer reboots at night when one is staged and no backup holds an inhibitor (AutoReboot); 'Startup finished' is the boot (HostBooted).",
      "id": 16
    },
    {
      "title": "Scheduled jobs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
