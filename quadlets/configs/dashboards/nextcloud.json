    },
    {
      "title": "Database and cache",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "{container=~\"nextcloud-(db|redis)\"} |~ \"(?i)error|fatal|warning|panic\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
