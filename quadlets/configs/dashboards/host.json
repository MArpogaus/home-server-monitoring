      "targets": [
        {
          "expr": "rate(node_pressure_cpu_waiting_seconds_total[$__rate_interval]) * 100",
          "legendFormat": "cpu",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(node_pressure_memory_waiting_seconds_total[$__rate_interval]) * 100",
          "legendFormat": "memory",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(node_pressure_io_waiting_seconds_total[$__rate_interval]) * 100",
          "legendFormat": "io",
          "range": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
