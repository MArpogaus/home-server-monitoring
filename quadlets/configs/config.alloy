loki.source.journal "host" {
  path           = "/var/log/journal"
  max_age        = "168h"
  relabel_rules  = loki.relabel.journal.rules
  forward_to     = [loki.process.drop_noise.receiver]
}

// Nextcloud's apps read config keys they never declared in their own config
// lexicon, and Nextcloud logs one info line per key per request for it. The
// calendar app alone produced 13.7k lines a day, 98 % of the application log,
// while changing nothing: the value is returned either way. Dropping them here
// keeps every other info line, which the audit trail needs.
loki.process "drop_noise" {
  forward_to = [loki.write.local.receiver]

  stage.drop {
    expression          = ".*is not defined in the config lexicon.*"
    drop_counter_reason = "nextcloud_config_lexicon"
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    target_label  = "user_unit"
  }
  // A manager's message about a unit names it in UNIT / USER_UNIT, not in
  // _SYSTEMD_UNIT (that is the manager itself); prefer the subject.
  rule {
    source_labels = ["__journal_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_user_unit"]
    regex         = "(.+)"
    target_label  = "user_unit"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }

  // Alloy 1.19 names the stream after the component; the rules select on this.
  rule {
    target_label = "job"
    replacement  = "systemd-journal"
  }
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
