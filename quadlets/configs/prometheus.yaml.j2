global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    source: prometheus

rule_files:
  - /etc/prometheus/rules.d/*.yaml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ['127.0.0.1:9100']

  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']

  - job_name: loki
    static_configs:
      - targets: ['127.0.0.1:3100']

  - job_name: alloy
    static_configs:
      - targets: ['127.0.0.1:12345']

  - job_name: grafana
    static_configs:
      - targets: ['127.0.0.1:3000']

  - job_name: alertmanager
    static_configs:
      - targets: ['127.0.0.1:9093']

  - job_name: blackbox
    scrape_interval: 60s
    metrics_path: /probe
    params:
      module: [http_ok]
    static_configs:
      - targets: {{ monitoring_service_probe_urls | to_json }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
