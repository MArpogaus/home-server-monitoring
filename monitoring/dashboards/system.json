    {
      "title": "Scheduled jobs",
      "type": "state-timeline",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "last_over_time({syslog_identifier=\"systemd\", unit=~\"btrfs-backup@.+\\\\.service|btrfs-snapshot@.+\\\\.service|auto-reboot-staged.service\"} |~ \"Starting |Deactivated successfully|Failed with result|Dependency failed for|Finished \" | regexp `(?P<ev>Starting|Deactivated successfully|Failed with result|Dependency failed for|Finished)` | label_format v=`{{ if eq .ev \"Starting\" }}1{{ else if or (eq .ev \"Failed with result\") (eq .ev \"Dependency failed for\") }}2{{ else }}0{{ end }}` | unwrap v [$__auto]) by (unit)",
          "legendFormat": "{{unit}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "finished",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "failed",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "One band per system job: where it turns blue the job was running, so the width is how long it took. Snapshots run daily and the backup after them. A job that does not succeed for 30 h raises JobStale; a red band raises ScheduledJobFailed. podman-auto-update is a user unit and is not in this band.",
      "id": 19
    },
